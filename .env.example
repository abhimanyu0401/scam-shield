# Copy this file to .env.local and fill in your keys
# Gemini API Key (Required for AI detection)
GEMINI_API_KEY=your_gemini_key_here

# Supabase Credentials (Required for auth & circles)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Google Safe Browsing API Key (Optional)
SAFE_BROWSING_API_KEY=your_google_cloud_key_here