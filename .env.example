# =============================================================================
# Scam Shield — Environment Configuration Example
# Copy this file to .env.local and populate with your own credentials:
#   cp .env.example .env.local
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Google Gemini AI (Required for AI analysis, OCR, and semantic embeddings)
# -----------------------------------------------------------------------------
# Get a free API key at https://aistudio.google.com
# Used for: multimodal scam analysis, Gemini Vision OCR, and gemini-embedding-001
GEMINI_API_KEY=your_gemini_api_key_here

# -----------------------------------------------------------------------------
# 2. Upstash Redis (Required for caching, rate limiting, circuit breaker & radar)
# -----------------------------------------------------------------------------
# Create a free Redis database at https://console.upstash.com
# Used for: analysis caching (15m TTL), circle reports (60d TTL), community votes,
# circuit breaker state machine, and model quota tracking.
REDIS_KV_REST_API_URL=https://your-database.upstash.io
REDIS_KV_REST_API_TOKEN=your_upstash_redis_rest_token_here

# -----------------------------------------------------------------------------
# 3. Supabase (Required for user authentication and circle memberships)
# -----------------------------------------------------------------------------
# Create a project at https://supabase.com
# Obtain URL and Publishable Key from Project Settings -> API (or Connect dialog).
# Note: Use the modern sb_publishable_... key, not the legacy anon JWT.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key_here

# -----------------------------------------------------------------------------
# 4. Optional External Providers (Graceful Fallback & Threat Intel)
# -----------------------------------------------------------------------------
# Google Safe Browsing Lookup API v4 (Optional):
# Used for real-time malicious/phishing URL detection during scam analysis.
# If omitted or invalid, link analysis fails open without blocking analysis.
SAFE_BROWSING_API_KEY=your_google_cloud_safe_browsing_key_here

# Groq API (Optional):
# Secondary AI fallback provider (runs OpenAI-compatible Llama models like openai/gpt-oss-120b).
# If omitted, system falls back to secondary Gemini models or the deterministic engine.
GROQ_API_KEY=your_groq_api_key_here
